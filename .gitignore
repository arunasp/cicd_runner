# Real host paths -- instance-specific, never committed. See
# .env.example for the template.
.env

# Windows Zone.Identifier alternate-data-stream metadata
*:Zone.Identifier

# Python
__pycache__/
*.pyc

# Local virtual environment for this project's host-side test
# dependencies (mcp, pytest) -- configure.ac prefers this over the
# system/conda python3 when present, but never creates it
# automatically. Standard Python convention: never committed, always
# environment-specific.
.venv/

# npm/cargo/pip dependency-download cache, computed and created by
# start.sh (see start.sh's own comment) inside this checkout rather
# than under $HOME -- purely a local speed optimization, never
# committed.
/.cicd-runner-cache/

# Built Desktop extension bundle -- not committed to git, distributed
# via GitHub Releases instead (added back 2026-08-09, reversing an
# earlier decision to commit it directly: four built .mcpb versions
# ended up accounting for most of a 4.18 MiB first push, and Releases
# is the conventional home for built binaries, not the source repo
# itself). Regenerate locally via `make build-extension`.
desktop-extension/dist/*.mcpb

# Runtime debug trace written by desktop-extension/index.js
desktop-extension/debug.log

# Real, live gaps found and fixed 2026-08-09 while auditing example
# Makefiles for cache-populating dependency steps: none of these
# were gitignored at all, so a real `make deps`/`make build` run in
# any example project risked a later `git add -A` accidentally
# staging hundreds of third-party files (confirmed live -- exactly
# this happened testing the hello-python/hello-typescript deps fixes
# below, caught before committing).
examples/*/node_modules/
examples/*/.deps
examples/*/target/

# npm dependencies for the desktop extension (@modelcontextprotocol/sdk,
# used directly in-process by index.js -- see index.js's own header
# comment for why). package.json IS committed; only the installed
# tree isn't.
desktop-extension/node_modules/

# Generated by autoreconf (./autogen.sh) -- mechanically reproducible
# from configure.ac/Makefile.am, not committed to version control per
# standard Automake convention. `make dist` bundles these INTO
# release tarballs (verified: a real `make dist` run produces a
# complete, working tarball including configure/Makefile.in/
# aclocal.m4) -- this gitignore only affects the git checkout path,
# where ./autogen.sh regenerates them locally.
/configure
/Makefile.in
/aclocal.m4
/install-sh
/missing
/autom4te.cache/
configure~

# Generated by ./configure itself -- environment-specific, never
# committed.
/Makefile
/config.log
/config.status
/stamp-h1

# Generated by `make dist`.
/cicd-runner-*.tar.gz

# Generated by `make check`.
.pytest_cache/

# Local diagnostic output from deploy_cicd_runner.sh -- scratch, not
# project content.
/logs/
